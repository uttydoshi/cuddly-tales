# Copy to .env and fill in real values. Never commit .env.

# --- LLM (via LiteLLM) ---
# Model name in LiteLLM format, e.g. anthropic/claude-sonnet-5-5 or openai/gpt-4o
LLM_MODEL=anthropic/claude-sonnet-5-5
# API key for the provider of LLM_MODEL (LiteLLM reads the provider-specific variable)
ANTHROPIC_API_KEY=your-anthropic-api-key
# OPENAI_API_KEY=your-openai-api-key

# --- Langfuse tracing ---
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
# EU cloud: https://cloud.langfuse.com  |  US cloud: https://us.cloud.langfuse.com
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Database ---
# SQLite locally; a Postgres URL in production
DATABASE_URL=sqlite:///./cuddly_tales.db
